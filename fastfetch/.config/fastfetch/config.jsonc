{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "color": {
      "1": "blue",
      "2": "blue"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " · ",
    "color": {
      "keys": "blue",
      "title": "cyan"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "",
      "keyColor": "magenta"
    },
    {
      "type": "display",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "",
      "keyColor": "red"
    },
    {
      "type": "theme",
      "key": "",
      "keyColor": "yellow"
    },
    {
      "type": "icons",
      "key": "",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "󰍛",
      "keyColor": "red"
    },
    "break",
    "colors"
  ]
}
