#!/usr/bin/env bash
# Apply the rice's GTK/icon/font settings. Safe to run any number of times.
set -euo pipefail
gs() { gsettings set org.gnome.desktop.interface "$1" "$2"; }
gs gtk-theme           'Arc-Dark'
gs icon-theme          'Papirus-Dark'
gs font-name           'Noto Sans 10'
gs monospace-font-name 'JetBrainsMono Nerd Font 10'
gs color-scheme        'prefer-dark'
gs cursor-size         24

# Grey Papirus folders (writes to /usr/share/icons, so it needs root). Skip if already grey.
if ! papirus-folders -l --theme Papirus-Dark 2>/dev/null | grep -qE '^\s*>\s*grey\b'; then
  sudo papirus-folders -C grey --theme Papirus-Dark
fi
