#!/usr/bin/env bash
# Bluetooth menu (rofi-bluetooth). It doesn't touch the adapter: if bluetooth is off or
# rfkill-blocked, the menu's own "Power: off" entry unblocks it and powers it on.
set -euo pipefail

# Clicking again while a menu is open closes it.
if pkill -x rofi; then exit 0; fi
exec rofi-bluetooth
