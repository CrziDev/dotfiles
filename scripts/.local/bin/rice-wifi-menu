#!/usr/bin/env bash
# Wifi menu: make sure the radio is on, then open networkmanager-dmenu (rofi).
# RICE_NO_UI=1 stops after the radio step (used by tests). RICE_NMCLI overrides nmcli (tests).
set -euo pipefail
nmcli_cmd=${RICE_NMCLI:-nmcli}

if [ "$("$nmcli_cmd" radio wifi)" != "enabled" ]; then
  "$nmcli_cmd" radio wifi on
fi
[ "${RICE_NO_UI:-0}" = 1 ] && exit 0

# Clicking again while a menu is open closes it.
if pkill -x rofi; then exit 0; fi
exec networkmanager_dmenu
