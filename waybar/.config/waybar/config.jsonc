{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces",
    "group/stats"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/notification",
    "pulseaudio",
    "backlight",
    "bluetooth",
    "network",
    "battery",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "󰝥",
      "urgent": "󰝥",
      "default": "󰝦",
      "visible": "󰝥"
    }
  },
  "group/stats": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "temperature"
    ]
  },
  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 3
  },
  "memory": {
    "format": "󰍛 {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "󰔏{temperatureC}°",
    "interval": 3,
    "tooltip-format": "CPU (Tctl) {temperatureC}°C"
  },
  "clock": {
    "format": "{0:%I:%M %p}  <span weight='500' alpha='55%'>{0:%a, %b %d}</span>",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "custom/notification": {
    "format": "{icon}{text}",
    "format-icons": {
      "none": "󰂜",
      "notification": "󰅸",
      "dnd-none": "󰂛",
      "dnd-notification": "󰂛",
      "inhibited-none": "󰂜",
      "inhibited-notification": "󰅸",
      "dnd-inhibited-none": "󰂛",
      "dnd-inhibited-notification": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb | jq --unbuffered -c '.text = (if .text == \"0\" then \"\" else \" \" + .text end)'",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip-format": "{desc} · {volume}%",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-middle": "pavucontrol"
  },
  "backlight": {
    "device": "amdgpu_bl1",
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃛",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "{controller_alias} · {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "$HOME/.local/bin/rice-bt-menu",
    "on-click-right": "blueman-manager"
  },
  "network": {
    "format-wifi": "{icon}",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-disabled": "󰤮",
    "tooltip-format-wifi": "{essid} · {signalStrength}% · {ipaddr}",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}",
    "tooltip-format-disconnected": "Offline",
    "on-click": "$HOME/.local/bin/rice-wifi-menu",
    "on-click-right": "nm-connection-editor"
  },
  "battery": {
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ]
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "$HOME/.local/bin/rice-powermenu"
  }
}
